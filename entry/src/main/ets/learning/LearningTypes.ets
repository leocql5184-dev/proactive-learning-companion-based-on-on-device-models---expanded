export type EventKind = 'task_started' | 'answer_submitted' | 'help_requested' | 'hint_shown' |
  'task_split_requested' | 'split_shown' | 'break_requested' | 'task_paused' | 'task_resumed' | 'task_finished' |
  'proactive_offered' | 'proactive_responded';

export class LearningEvent {
  eventId: string = '';
  sessionId: string = '';
  taskId: string = '';
  sequence: number = 0;
  timestamp: number = 0;
  offsetMs: number = 0;
  kind: EventKind = 'task_started';
  source: string = 'app_observation';
  correct: boolean | null = null;
  hintDepth: number | null = null;
  requestId: string = '';
  loadHigh: boolean | null = null;
  reasonCode: string = '';
  response: string = '';
}

export class LearningSession {
  sessionId: string = '';
  taskId: string = '';
  startedAt: number = 0;
  updatedAt: number = 0;
  status: string = 'active';
  // This is functional progress, saved independently of optional behavior collection.
  draft: string = '';
  lastResult: string = '';
  pendingRequestId: string = '';
  pendingKind: string = '';
  pendingDepth: number | null = null;
  cardKind: string = '';
  cardDepth: number = 1;
  cardRequestId: string = '';
  coverageComplete: boolean = false;
  lastActivityAt: number = 0;
  offerId: string = '';
  offerKind: string = '';
  offerReason: string = '';
  offerResponse: string = '';
  offerAt: number = 0;
  suppressUntil: number = 0;
  events: LearningEvent[] = [];
}

export class FeatureSnapshot {
  schemaVersion: string = 'decision-features-v1';
  sessionId: string = '';
  taskId: string = '';
  capturedAt: number = 0;
  eventIds: string[] = [];
  values: (number | null)[] = [];
  mask: number[] = [];
  ready: boolean = false;
  reason: string = '';
}

export class LearningState {
  version: number = 1;
  collectionEnabled: boolean = false;
  proactiveEnabled: boolean = false;
  sequence: number = 0;
  activeSessionId: string = '';
  sessions: LearningSession[] = [];
}

export class LearningTask {
  id: string; title: string; stem: string; difficulty: number; hint1: string; hint2: string; split: string;
  constructor(id: string, title: string, stem: string,
    difficulty: number, hint1: string, hint2: string, split: string) {
    this.id = id; this.title = title; this.stem = stem; this.difficulty = difficulty;
    this.hint1 = hint1; this.hint2 = hint2; this.split = split;
  }
}

// Text from the project's kept48 / question_guidance_48, not generated by a model.
export const LEARNING_TASKS: LearningTask[] = [
  new LearningTask('FUNC-FB-0032', '二次方程的实根',
    '若关于 x 的一元二次方程 kx² − 2x + 1 = 0 有两个不相等的实根，求 k 的取值范围。', 2,
    '先检查“一元二次方程”这个条件：如果 k=0，式子里还会有二次项吗？',
    '一元二次方程的二次项系数不能为零。这里 x² 的系数是 k，你能据此补一个条件吗？',
    '先检查二次项系数的条件，再写出两个不相等实根对判别式的要求。'),
  new LearningTask('FUNC-SC-0193', '对数与指数',
    '若 lg x = 2，则 x 的值为：A. 2　B. 100　C. 0.01　D. e²', 1,
    'lg 表示以什么数为底的对数？可以把等式改写成指数形式吗？',
    '使用 logₐb=c 与 aᶜ=b 的对应关系，确认等式中底数、指数和真数各是哪一项。',
    '第一步，确认 lg 的底数，并把 lg x=2 改写成指数形式；第二步，再计算 x 的值。先完成第一步。'),
  new LearningTask('FUNC-SA-0139', '区间上的最值',
    '已知 a、b ∈ [0,2]，求 a² − a + |b − a| 的最大值。', 3,
    '先固定 a。b 在 [0,2] 内变化时，距离 |b−a| 最大可能在哪个端点？',
    '分别考虑 b=0 与 b=2，得到关于 a 的两个二次式，再在 a∈[0,2] 上比较它们的最大值。',
    '先固定 a，比较 b 的两个端点；再分别考察得到的关于 a 的表达式。')
];

export function taskById(id: string): LearningTask | undefined {
  return LEARNING_TASKS.find((task: LearningTask) => task.id === id);
}

// Only the original multiple-choice question is graded. Free-form math stays unknown.
export function gradeAnswer(taskId: string, answer: string): boolean | null {
  if (taskId !== 'FUNC-SC-0193') { return null; }
  const value = answer.trim().toUpperCase();
  if (['A', 'B', 'C', 'D'].includes(value)) { return value === 'B'; }
  return null;
}
